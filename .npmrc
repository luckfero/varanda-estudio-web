# `audit=false` saiu em 2026-09-08: ele silenciava o relatorio de
# vulnerabilidade em toda instalacao, e foi por isso que 20 avisos
# ficaram invisiveis por semanas. Quem quiser so o essencial roda
# `npm run audit:prod`, que olha o que vai para producao.
fund=false
update-notifier=false
cache=.sites-runtime/npm-cache
